@page "/buscar"
@model BuscarModel
@{ ViewData["Title"] = "Seguí una pista"; }
<section class="section-wrap page-heading"><p class="eyebrow red">BUSCAR EN EL MUSEO</p><h1>Seguí<br /><em>una pista.</em></h1><p class="heading-intro">Un nombre, una fecha o una idea pueden abrir otra historia.</p></section><section class="section-wrap search-section" data-search data-catalog-url="/api/catalogo"><form method="get" class="search-form"><label for="searchq">¿Qué querés descubrir?</label><div><input id="searchq" name="q" type="search" value="@Model.Q" maxlength="120" placeholder="Probá con Estrada, Matagalpa o soberanía" required/><button class="button blue" type="submit">Buscar <span>→</span></button></div><span asp-validation-for="Q"></span></form><p class="search-status" data-search-status role="status">@(string.IsNullOrWhiteSpace(Model.Q) ? "Explorá los acontecimientos, protagonistas y fuentes del archivo." : $"{Model.Resultados.Count} resultados para «{Model.Q}».")</p><div class="search-results" data-search-results>@foreach(var r in Model.Resultados){<a class="search-result" href="@r.Enlace"><span class="eyebrow">@r.Tipo</span><h2>@r.Titulo <span>↗</span></h2><p>@r.Resumen</p></a>}</div><div class="search-suggestions"><span>PARA EMPEZAR</span><a href="/buscar?q=Estrada">Estrada ↗</a><a href="/buscar?q=Matagalpa">Matagalpa ↗</a><a href="/buscar?q=1856">1856 ↗</a></div></section>

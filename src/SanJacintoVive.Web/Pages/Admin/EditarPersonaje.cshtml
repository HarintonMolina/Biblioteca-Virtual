@page "/admin/editarpersonaje/{id:int?}"
@model SanJacintoVive.Web.Pages.Admin.EditarPersonajeModel
@{ ViewData["Title"] = "Editar personaje"; }
<section class="section-wrap editor-section"><a class="back-link" asp-page="Index">← Volver al panel</a><h1>@(Model.Input.Id==0 ? "Crear" : "Editar") personaje</h1><form method="post" class="editor-form"><div asp-validation-summary="All" class="validation" role="alert"></div><input type="hidden" asp-for="Input.Id"/><label asp-for="Input.Nombre">Nombre</label><input asp-for="Input.Nombre" type="text"/><span asp-validation-for="Input.Nombre"></span><label asp-for="Input.Slug">Identificador de la dirección</label><input asp-for="Input.Slug" type="text"/><span asp-validation-for="Input.Slug"></span><small>Solo letras minúsculas sin tildes y números, sin espacios. Cambiarlo modifica la dirección pública.</small><label asp-for="Input.Bando">Grupo o bando</label><input asp-for="Input.Bando" type="text"/><span asp-validation-for="Input.Bando"></span><label asp-for="Input.Rol">Papel en la historia</label><input asp-for="Input.Rol" type="text"/><span asp-validation-for="Input.Rol"></span><label asp-for="Input.Fechas">Fechas o identificación</label><input asp-for="Input.Fechas" type="text"/><span asp-validation-for="Input.Fechas"></span><label asp-for="Input.Biografia">Biografía</label><textarea asp-for="Input.Biografia" rows="8"></textarea><span asp-validation-for="Input.Biografia"></span><fieldset class="checkbox-list"><legend>Fuentes que respaldan el contenido</legend>@foreach(var fuente in Model.Fuentes){<label><input type="checkbox" name="FuenteIds" value="@fuente.Id" checked="@(Model.FuenteIds.Contains(fuente.Id))"/>@fuente.Titulo</label>}<span asp-validation-for="FuenteIds"></span></fieldset><div class="form-actions"><button class="button blue" type="submit">Guardar contenido →</button><a asp-page="Index">Cancelar</a></div></form></section>
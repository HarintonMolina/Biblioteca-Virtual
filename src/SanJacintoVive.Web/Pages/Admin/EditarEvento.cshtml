@page "/admin/editarevento/{id:int?}"
@model SanJacintoVive.Web.Pages.Admin.EditarEventoModel
@{ ViewData["Title"] = "Editar evento"; }
<section class="section-wrap editor-section"><a class="back-link" asp-page="Index">← Volver al panel</a><h1>@(Model.Input.Id==0 ? "Crear" : "Editar") evento</h1><form method="post" class="editor-form"><div asp-validation-summary="All" class="validation" role="alert"></div><input type="hidden" asp-for="Input.Id"/><label asp-for="Input.Titulo">Título</label><input asp-for="Input.Titulo" type="text"/><span asp-validation-for="Input.Titulo"></span><label asp-for="Input.Slug">Identificador de la dirección</label><input asp-for="Input.Slug" type="text"/><span asp-validation-for="Input.Slug"></span><small>Solo letras minúsculas sin tildes y números, sin espacios. Cambiarlo modifica la dirección pública.</small><label asp-for="Input.Fecha">Fecha</label><input asp-for="Input.Fecha" type="date"/><span asp-validation-for="Input.Fecha"></span><label asp-for="Input.Lugar">Lugar</label><input asp-for="Input.Lugar" type="text"/><span asp-validation-for="Input.Lugar"></span><label asp-for="Input.Capitulo">Capítulo</label><input asp-for="Input.Capitulo" type="text"/><span asp-validation-for="Input.Capitulo"></span><label asp-for="Input.Resumen">Resumen</label><textarea asp-for="Input.Resumen" rows="4"></textarea><span asp-validation-for="Input.Resumen"></span><label asp-for="Input.Descripcion">Relato completo</label><textarea asp-for="Input.Descripcion" rows="8"></textarea><span asp-validation-for="Input.Descripcion"></span><fieldset class="checkbox-list"><legend>Fuentes que respaldan el contenido</legend>@foreach(var fuente in Model.Fuentes){<label><input type="checkbox" name="FuenteIds" value="@fuente.Id" checked="@(Model.FuenteIds.Contains(fuente.Id))"/>@fuente.Titulo</label>}<span asp-validation-for="FuenteIds"></span></fieldset><fieldset class="checkbox-list"><legend>Protagonistas relacionados</legend>@foreach(var personaje in Model.Personajes){<label><input type="checkbox" name="PersonajeIds" value="@personaje.Id" checked="@(Model.PersonajeIds.Contains(personaje.Id))"/>@personaje.Nombre</label>}</fieldset><div class="form-actions"><button class="button blue" type="submit">Guardar contenido →</button><a asp-page="Index">Cancelar</a></div></form></section>
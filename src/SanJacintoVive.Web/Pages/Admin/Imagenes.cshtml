@page "/admin/imagenes"
@model SanJacintoVive.Web.Pages.Admin.ImagenesModel
@{ ViewData["Title"] = "Subir una imagen"; }
<section class="section-wrap editor-section"><a class="back-link" asp-page="Index">← Volver al panel</a><h1>Agregar una imagen</h1><form method="post" enctype="multipart/form-data" class="editor-form"><div asp-validation-summary="All" class="validation" role="alert"></div><label asp-for="Archivo">Imagen JPG, PNG o WebP de hasta 5 MB</label><input asp-for="Archivo" type="file" accept="image/jpeg,image/png,image/webp"/><label asp-for="Descripcion">Descripción para quienes no ven la imagen</label><input asp-for="Descripcion"/><label asp-for="Credito">Autoría, procedencia y licencia</label><input asp-for="Credito"/><label asp-for="Destino">Relacionar con</label><select asp-for="Destino"><option value="">Elegí un contenido</option><optgroup label="Acontecimientos">@foreach(var e in Model.Eventos){<option value="evento:@e.Id">@e.Titulo</option>}</optgroup><optgroup label="Protagonistas">@foreach(var p in Model.Personajes){<option value="personaje:@p.Id">@p.Nombre</option>}</optgroup></select><button type="submit" class="button blue">Guardar imagen →</button></form></section>

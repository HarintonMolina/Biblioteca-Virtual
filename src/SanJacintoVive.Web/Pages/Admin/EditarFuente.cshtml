@page "/admin/editarfuente/{id:int?}"
@model SanJacintoVive.Web.Pages.Admin.EditarFuenteModel
@{ ViewData["Title"] = "Editar fuente"; }
<section class="section-wrap editor-section"><a class="back-link" asp-page="Index">← Volver al panel</a><h1>@(Model.Input.Id==0 ? "Crear" : "Editar") fuente</h1><form method="post" class="editor-form"><div asp-validation-summary="All" class="validation" role="alert"></div><input type="hidden" asp-for="Input.Id"/><label asp-for="Input.Titulo">Título</label><input asp-for="Input.Titulo" type="text"/><span asp-validation-for="Input.Titulo"></span><label asp-for="Input.Slug">Identificador de la dirección</label><input asp-for="Input.Slug" type="text"/><span asp-validation-for="Input.Slug"></span><small>Solo letras minúsculas sin tildes y números, sin espacios. Cambiarlo modifica la dirección pública.</small><label asp-for="Input.Autor">Autoría</label><input asp-for="Input.Autor" type="text"/><span asp-validation-for="Input.Autor"></span><label asp-for="Input.Ano">Año</label><input asp-for="Input.Ano" type="text"/><span asp-validation-for="Input.Ano"></span><label asp-for="Input.Tipo">Tipo documental</label><select asp-for="Input.Tipo"><option>Primaria</option><option>Secundaria</option><option>Institucional</option></select><span asp-validation-for="Input.Tipo"></span><label asp-for="Input.Enlace">Enlace HTTPS</label><input asp-for="Input.Enlace" type="url"/><span asp-validation-for="Input.Enlace"></span><label asp-for="Input.Referencia">Referencia bibliográfica</label><textarea asp-for="Input.Referencia" rows="4"></textarea><span asp-validation-for="Input.Referencia"></span><label asp-for="Input.Descripcion">Descripción</label><textarea asp-for="Input.Descripcion" rows="8"></textarea><span asp-validation-for="Input.Descripcion"></span><label asp-for="Input.Nota">Guía de lectura crítica</label><textarea asp-for="Input.Nota" rows="4"></textarea><span asp-validation-for="Input.Nota"></span><div class="form-actions"><button class="button blue" type="submit">Guardar contenido →</button><a asp-page="Index">Cancelar</a></div></form></section>
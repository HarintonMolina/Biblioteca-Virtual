@page "/admin"
@model SanJacintoVive.Web.Pages.Admin.IndexModel
@{ ViewData["Title"] = "Administración del museo"; }
<section class="section-wrap admin-section"><div class="admin-heading"><div><p class="eyebrow red">GESTIÓN DEL ARCHIVO</p><h1>Administración</h1></div><form method="post" asp-page="Salir"><button class="button outline" type="submit">Cerrar sesión</button></form></div>@if(Model.Mensaje is not null){<p class="admin-message" role="status">@Model.Mensaje</p>}<div class="admin-toolbar"><a class="button blue" asp-page="EditarEvento">Crear evento +</a><a class="button outline" asp-page="EditarPersonaje">Crear personaje +</a><a class="button outline" asp-page="EditarFuente">Crear fuente +</a><a class="button outline" asp-page="Imagenes">Subir imagen ↗</a></div>
<h2>Acontecimientos</h2><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Fecha</th><th>Título</th><th>Acciones</th></tr></thead><tbody>@foreach(var item in Model.Eventos){<tr><td>@item.Fecha</td><td>@item.Titulo</td><td><a asp-page="EditarEvento" asp-route-id="@item.Id">Editar</a><form method="post" asp-page-handler="Eliminar" data-confirm="¿Eliminar este evento y sus imágenes?" class="inline-form"><input type="hidden" name="tipo" value="evento"/><input type="hidden" name="id" value="@item.Id"/><button type="submit">Eliminar</button></form></td></tr>}</tbody></table></div>
<h2>Protagonistas</h2><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Nombre</th><th>Grupo</th><th>Acciones</th></tr></thead><tbody>@foreach(var item in Model.Personajes){<tr><td>@item.Nombre</td><td>@item.Bando</td><td><a asp-page="EditarPersonaje" asp-route-id="@item.Id">Editar</a><form method="post" asp-page-handler="Eliminar" data-confirm="¿Eliminar este personaje y sus imágenes?" class="inline-form"><input type="hidden" name="tipo" value="personaje"/><input type="hidden" name="id" value="@item.Id"/><button type="submit">Eliminar</button></form></td></tr>}</tbody></table></div>
<h2>Fuentes</h2><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Título</th><th>Tipo</th><th>Acciones</th></tr></thead><tbody>@foreach(var item in Model.Fuentes){<tr><td>@item.Titulo</td><td>@item.Tipo</td><td><a asp-page="EditarFuente" asp-route-id="@item.Id">Editar</a><form method="post" asp-page-handler="Eliminar" data-confirm="¿Eliminar esta fuente?" class="inline-form"><input type="hidden" name="tipo" value="fuente"/><input type="hidden" name="id" value="@item.Id"/><button type="submit">Eliminar</button></form></td></tr>}</tbody></table></div>
<h2>Imágenes</h2><div class="admin-images">@foreach(var item in Model.Imagenes){<figure><img src="@item.Ruta" alt="@item.Descripcion" loading="lazy"/><figcaption>@item.Credito</figcaption><form method="post" asp-page-handler="Eliminar" data-confirm="¿Eliminar esta imagen?"><input type="hidden" name="tipo" value="imagen"/><input type="hidden" name="id" value="@item.Id"/><button type="submit">Eliminar imagen</button></form></figure>}</div></section>

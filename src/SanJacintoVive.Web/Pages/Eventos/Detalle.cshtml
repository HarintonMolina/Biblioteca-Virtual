@page "/eventos/{slug}"
@model SanJacintoVive.Web.Pages.Eventos.DetalleModel
@{ ViewData["Title"] = Model.Evento.Titulo; ViewData["Description"] = Model.Evento.Resumen; }
<article class="section-wrap detail-page"><a class="back-link" asp-page="/LineaTiempo">← Volver a la línea del tiempo</a><header class="detail-heading"><p class="eyebrow red">@Model.Evento.Capitulo · @Texto.Fecha(Model.Evento.Fecha)</p><h1>@Model.Evento.Titulo</h1><p class="detail-lead">@Model.Evento.Resumen</p><span class="location-label">@Model.Evento.Lugar</span></header><div class="detail-grid"><div class="prose" data-narration>@foreach(var p in Model.Evento.Descripcion.Split("\n\n")){<p>@p</p>}@foreach(var i in Model.Evento.Imagenes){<figure><img src="@i.Ruta" alt="@i.Descripcion" loading="lazy"/><figcaption>@i.Credito</figcaption></figure>}@if(Model.Evento.Slug == "sanjacinto"){<a class="button blue" asp-page="/Batalla">Recorrer las etapas de la batalla ↗</a>}<button class="listen-button" type="button" data-listen hidden>Escuchar este relato ♫</button><p class="listen-status" data-listen-status role="status"></p></div><aside class="detail-aside"><p class="eyebrow">SEGUÍ LAS HUELLAS</p><h2>Las fuentes de este relato</h2>@foreach(var f in Model.Evento.Fuentes){<a class="source-mini" asp-page="/Biblioteca/Detalle" asp-route-slug="@f.Fuente.Slug"><span>@f.Fuente.Tipo · @f.Fuente.Ano</span><b>@f.Fuente.Titulo ↗</b><small>@f.Fuente.Autor</small></a>}<p class="aside-note">Los relatos históricos se construyen contrastando evidencias. Abrí las fichas para conocer la perspectiva de cada fuente.</p></aside></div>@if(Model.Evento.Personajes.Any()){<section class="related-section"><p class="eyebrow red">EN ESTA HISTORIA</p><h2>Conocé a sus protagonistas.</h2><div class="related-links">@foreach(var p in Model.Evento.Personajes){<a asp-page="/Personajes/Detalle" asp-route-slug="@p.Personaje.Slug">@p.Personaje.Nombre ↗</a>}</div></section>}</article>

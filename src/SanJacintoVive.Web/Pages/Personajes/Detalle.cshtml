@page "/personajes/{slug}"
@model SanJacintoVive.Web.Pages.Personajes.DetalleModel
@{ ViewData["Title"] = Model.Personaje.Nombre; }
<article class="section-wrap detail-page"><a class="back-link" asp-page="/Personajes/Index">← Volver a los protagonistas</a><header class="detail-heading"><p class="eyebrow red">@Model.Personaje.Bando · @Model.Personaje.Fechas</p><h1>@Model.Personaje.Nombre</h1><p class="detail-lead">@Model.Personaje.Rol</p></header><div class="detail-grid"><div class="prose" data-narration>@if(Model.Personaje.Slug=="estrada"){<figure class="biography-portrait"><img src="~/images/estrada.webp" width="400" height="500" alt="Retrato histórico de José Dolores Estrada"/><figcaption>Autor desconocido · Dominio público · <a href="https://commons.wikimedia.org/wiki/File:Jos%C3%A9_Dolores_Estrada.jpg" target="_blank" rel="noopener noreferrer">Wikimedia Commons ↗</a></figcaption></figure>}@foreach(var p in Model.Personaje.Biografia.Split("\n\n")){<p>@p</p>}@foreach(var i in Model.Personaje.Imagenes){<figure><img src="@i.Ruta" alt="@i.Descripcion" loading="lazy"/><figcaption>@i.Credito</figcaption></figure>}<button class="listen-button" type="button" data-listen hidden>Escuchar este relato ♫</button><p class="listen-status" data-listen-status role="status"></p></div><aside class="detail-aside"><p class="eyebrow">PARA CONOCER MÁS</p><h2>Fuentes de la ficha</h2>@foreach(var f in Model.Personaje.Fuentes){<a class="source-mini" asp-page="/Biblioteca/Detalle" asp-route-slug="@f.Fuente.Slug"><span>@f.Fuente.Tipo · @f.Fuente.Ano</span><b>@f.Fuente.Titulo ↗</b><small>@f.Fuente.Autor</small></a>}</aside></div><section class="related-section"><p class="eyebrow red">CONEXIONES EN EL TIEMPO</p><h2>Su lugar en los acontecimientos.</h2><div class="related-links">@foreach(var e in Model.Personaje.Eventos.OrderBy(x=>x.Evento.Fecha)){<a asp-page="/Eventos/Detalle" asp-route-slug="@e.Evento.Slug">@e.Evento.Titulo ↗</a>}</div></section></article>

@page "/biblioteca/{slug}"
@model SanJacintoVive.Web.Pages.Biblioteca.DetalleModel
@{ ViewData["Title"] = Model.Fuente.Titulo; }
<article class="section-wrap detail-page"><a class="back-link" asp-page="/Biblioteca/Index">← Volver al archivo</a><header class="detail-heading"><p class="eyebrow red">FUENTE @Model.Fuente.Id.ToString("00") · @Model.Fuente.Tipo · @Model.Fuente.Ano</p><h1>@Model.Fuente.Titulo</h1><p class="detail-lead">@Model.Fuente.Autor</p></header><div class="detail-grid"><div class="prose"><h2>¿Qué podés encontrar?</h2><p>@Model.Fuente.Descripcion</p><h2>Una pista para leerla</h2><p>@Model.Fuente.Nota</p><a class="button blue" href="@Model.Fuente.Enlace" target="_blank" rel="noopener noreferrer">Consultar la fuente original <span>↗</span></a><p class="external-note">Se abre el documento o catálogo de la institución en una pestaña nueva. Su disponibilidad depende del sitio de origen.</p>@if(Model.Fuente.Slug=="arellano"){<details class="document-viewer"><summary>Leer el documento en el visor</summary><iframe src="https://www.mined.gob.ni/biblioteca/wp-content/uploads/2025/09/LOS-DOS-COMBATES-DE-SAN-JACINTO.pdf" title="Los dos combates de San Jacinto, PDF de la Biblioteca MINED" loading="lazy" referrerpolicy="no-referrer"></iframe><p>Si el visor no carga, usá el enlace a la fuente original.</p></details>}</div><aside class="detail-aside"><p class="eyebrow">REFERENCIA BIBLIOGRÁFICA</p><p class="citation" data-citation>@Model.Fuente.Referencia @Model.Fuente.Enlace</p><button class="button outline" data-copy-citation type="button">Copiar referencia ↗</button><p role="status" data-copy-status></p></aside></div>@if(Model.Fuente.Eventos.Any()){<section class="related-section"><p class="eyebrow red">ESTA FUENTE AYUDA A CONTAR</p><div class="related-links">@foreach(var e in Model.Fuente.Eventos.OrderBy(x=>x.Evento.Fecha)){<a asp-page="/Eventos/Detalle" asp-route-slug="@e.Evento.Slug">@e.Evento.Titulo ↗</a>}</div></section>}</article>
